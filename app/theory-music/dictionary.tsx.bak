export const MUSIC_DICTIONARY_LIST: MusicDictionaryEntry[] =
  Object.values(MUSIC_DICTIONARY);

export function getMusicTerm(
  termKey: string,
): MusicDictionaryEntry | undefined {
  return MUSIC_DICTIONARY[termKey];
}

export function findMusicTerms(keyword: string): MusicDictionaryEntry[] {
  const q = keyword.trim().toLowerCase();
  if (!q) return MUSIC_DICTIONARY_LIST;

  return MUSIC_DICTIONARY_LIST.filter((entry) => {
    const inTerm = entry.term.toLowerCase().includes(q);
    const inAlias = entry.aliases?.some((alias) =>
      alias.toLowerCase().includes(q),
    );
    const inShort = entry.shortDefinition.toLowerCase().includes(q);
    const inDetail = entry.detailedDefinition.toLowerCase().includes(q);
    return Boolean(inTerm || inAlias || inShort || inDetail);
  });
}
